{
  "server": {
    "host": "127.0.0.1",
    "port": 8000
  },
  "engines": [
    {
      "id": "llama-cpp",
      "display_name": "llama.cpp server",
      "executable_path": "",
      "model_path": "",
      "working_directory": "",
      "args": [
        "--host",
        "127.0.0.1",
        "--port",
        "8081",
        "--ctx-size",
        "2048",
        "--n-gpu-layers",
        "0",
        "--cors-origins",
        "localhost",
        "--no-cors-credentials",
        "-m",
        "{model_path}"
      ],
      "upstream_base_url": "http://127.0.0.1:8081",
      "capabilities": [
        "chat",
        "streaming-chat",
        "embeddings-if-supported-by-engine"
      ],
      "default_for_chat": true
    }
  ]
}
