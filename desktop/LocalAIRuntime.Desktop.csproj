    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LocalAIRuntime.Desktop</AssemblyName>
    <RootNamespace>LocalAIRuntime.Desktop</RootNamespace>
