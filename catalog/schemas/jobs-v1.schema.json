{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-runtime.example/schemas/jobs-v1.schema.json",
  "title": "Local AI Runtime Persistent Jobs",
  "description": "The unified durable per-user job list returned by GET /v1/jobs. Component downloads retain their reviewed retry rules; engine and inference operations are recorded but are never replayed automatically.",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "array",
      "items": { "$ref": "#/$defs/job" }
    }
  },
  "$defs": {
    "job": {
      "type": "object",
      "required": [
        "id", "item_id", "kind", "state", "phase", "version", "downloaded_bytes", "total_bytes",
        "progress_percent", "installed_path", "error", "last_error", "error_code", "created_at",
        "updated_at", "started_at", "finished_at", "attempt", "cancel_requested", "retryable"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "item_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["engine", "model", "update", "engine-start", "engine-stop", "inference"] },
        "state": { "enum": ["queued", "running", "downloading", "verifying", "extracting", "configuring", "succeeded", "failed", "canceled", "interrupted"] },
        "phase": { "type": "string" },
        "version": { "type": "string" },
        "downloaded_bytes": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "progress_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "installed_path": { "type": "string" },
        "error": { "type": "string" },
        "last_error": { "type": "string" },
        "error_code": { "type": "string" },
        "created_at": { "type": "integer", "minimum": 0 },
        "updated_at": { "type": "integer", "minimum": 0 },
        "started_at": { "type": "integer", "minimum": 0 },
        "finished_at": { "type": "integer", "minimum": 0 },
        "attempt": { "type": "integer", "minimum": 1 },
        "cancel_requested": { "type": "boolean" },
        "retryable": { "type": "boolean" },
        "queue_position": { "type": "integer", "minimum": 0 },
        "dependency_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "resolution"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "resolution": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "cancellable": { "type": "boolean" },
        "progress_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
